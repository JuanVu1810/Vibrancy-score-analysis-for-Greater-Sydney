# Copy this file to .env and set a private password before running Docker.
# Never commit .env.
DB_PASSWORD=
DB_USER=postgres
DB_NAME=postgres
DB_PORT=5433

# Optional Transport for NSW Open Data API key (free: register at opendata.transport.nsw.gov.au).
# Only the ETL uses it, to download the GTFS stops through the API; without it the ETL falls back to the
# public download link. Put the real key in .env, never here.
TFNSW_API_KEY=
